{
	// This file deliberately contains no account, route, secret, object storage,
	// queue, or environment binding; its variables name the model profile and
	// the report-email sender settings.
	// The D1 entry identifies the MVP 1 database only; it does not deploy the
	// Worker or apply its schema.
	"name": "shortlist-web",
	"main": ".output/server/index.mjs",
	"compatibility_date": "2026-10-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".output/public"
	},
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"**/*.mjs",
				"**/*.js"
			]
		}
	],
	"vars": {
		// The approved model profile (a row in model_test_profiles) that writes
		// every report. Change it to switch model; the profile must be approved.
		"SHORTLIST_MODEL_PROFILE": "claude-haiku-5-5",
		// Report emails (Issue #96) go through Gmail SMTP. SMTP_USER and
		// SMTP_PASS are Worker secrets, never values in this file.
		"SMTP_HOST": "smtp.gmail.com",
		"SMTP_PORT": "465",
		"REPORT_EMAIL_FROM": "ShortList by SuccessByCS <reports@successbycs.com>",
		"REPORT_EMAIL_REPLY_TO": "chris@successbycs.com"
	},
	"d1_databases": [
		{
			"binding": "SHORTLIST_DB",
			"database_name": "shortlist-mvp1",
			"database_id": "445a6145-5fe1-422d-800c-e152ded2b0a3"
		}
	]
}
